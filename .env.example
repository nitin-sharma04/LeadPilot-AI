# LeadPilot AI — local development only.
# Copy values into .env / .env.local. Never commit real credentials.

DATABASE_URL="postgresql://leadpilot:leadpilot@localhost:5432/leadpilot?schema=public"
# Supabase on Render MUST use the pooler (IPv4). Direct db.*.supabase.co is often IPv6-only.
# DATABASE_URL = Transaction pooler (:6543) for the app
# DIRECT_URL   = Session pooler (:5432) for prisma migrate
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=30"
# DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Public app URL (Auth.js + OAuth + embeds). Production MUST set APP_URL.
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
# Voice-server → Next.js appointment APIs (defaults to APP_URL/AUTH_URL)
# VOICE_APP_URL="http://127.0.0.1:3000"
# Dev-only replay finalize for existing calls (also allowed when NODE_ENV!==production)
# VOICE_APPOINTMENT_REPLAY=true

# Demo mode: production should leave DEMO_MODE unset/false
# DEMO_MODE=true
# Seeded demo login (seed + Try Live Demo). Not production auth.
DEMO_EMAIL="demo@apexdigitalsolutions.com"
DEMO_PASSWORD="replace-with-a-strong-demo-password"
# SEED_WIPE=true
# ALLOW_PROD_SEED=true

# Optional Supabase API (LeadPilot auth remains Auth.js + Prisma)
# NEXT_PUBLIC_SUPABASE_URL=https://miixtzoucovwyngonuko.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI provider selection: gemini (default) | openai | experiential-labs
AI_PROVIDER=gemini

# Google Gemini — server-side only. Never use NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional faster model for live phone turns (defaults to gemini-3.6-flash)
# GEMINI_VOICE_MODEL=gemini-3.6-flash
# GEMINI_VOICE_TIMEOUT_MS=6000
GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Gemini Live (Phase 5B realtime) — current recommended Live model
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Natural conversational voice (Aoede | Callirrhoe | Achird | Zubenelgenubi | Sulafat)
GEMINI_LIVE_VOICE=Aoede
# Optional: verbose realtime audio pipeline logs on voice-server (no audio bytes)
# VOICE_AUDIO_DEBUG=true
# Optional comma-separated custom vocabulary terms
# GEMINI_LIVE_VOCABULARY=Apex Dental,online booking

# GEMINI_VAD_SILENCE_MS=900
# Phone-safe end-of-speech (LOW waits through short pauses):
# GEMINI_VAD_END_SENSITIVITY=END_SENSITIVITY_LOW
# GEMINI_VAD_PREFIX_PADDING_MS=120
# After AI audio plays, ignore echo/false barge-in (guard only — does not generate speech):
# VOICE_POST_SPEECH_GUARD_MS=650
# Ignore tiny noise bursts as barge-in during AI playback:
# VOICE_BARGE_IN_MIN_SPEECH_MS=170
# When Gemini omits inputTranscription.finished, wait this long after the last chunk:
# VOICE_INPUT_FINALIZE_DEBOUNCE_MS=350
# VOICE_INPUT_FINALIZE_MS=350
# Optional holding phrase while Gemini Live is slow (default off):
# VOICE_ENABLE_FILLER=false
# Drop inbound frames quieter than this RMS while AI is speaking (echo):
# VOICE_ECHO_RMS_THRESHOLD=500
# VOICE_LATENCY_DEBUG=true
# Local Voice Lab only (ignored in production):
# VOICE_LAB_NETWORK_DELAY_MS=400
# VOICE_LAB_JITTER_MS=150
# Voice Lab UI also has NORMAL / +300ms / +500ms / +700ms / +1000ms presets.

# Realtime TTS: Deepgram Flux is the default voice.
VOICE_TTS_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=flux-hannah-en
DEEPGRAM_TTS_SPEED=1.0
DEEPGRAM_TTS_EXPRESSIVITY=0
# Fallback to Gemini Live native audio:
# VOICE_TTS_PROVIDER=gemini

# Voice calling
VOICE_PROVIDER=twilio
# realtime (default) | turn_based
VOICE_MODE=realtime
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public HTTPS base for Twilio HTTP webhooks (Next.js) — must match the live Render URL
VOICE_WEBHOOK_BASE_URL=
# Emergency only: skip Twilio signature checks (also works in production if set true)
# TWILIO_SKIP_SIGNATURE_VALIDATION=false
# Public WSS for Twilio Media Streams — production must be a stable Render host
# (not trycloudflare/ngrok). Example: wss://leadpilot-voice.onrender.com/media-stream
VOICE_STREAM_URL=
VOICE_SERVER_PORT=8081
# VOICE_ALLOW_TUNNEL=false
VOICE_MODE=realtime
# Defensive max duration for realtime calls (seconds). Safety ceiling only.
VOICE_MAX_CALL_DURATION_SECONDS=600
# Dev-only: TWILIO_SKIP_SIGNATURE_VALIDATION=false

# Google Calendar (Phase 6) — server-side OAuth only
# Demo mode keeps Connect active without real Google Cloud credentials.
GOOGLE_CALENDAR_DEMO=true
GOOGLE_CLIENT_ID=demo-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=demo-google-client-secret
# Local: http://localhost:3000/api/integrations/google-calendar/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback

# Gmail (Phase 7) — same Google OAuth client; separate redirect + scopes
# Defaults to calendar demo detection when GOOGLE_GMAIL_DEMO is unset
# GOOGLE_GMAIL_DEMO=true
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
# Cron for follow-up scheduler + reply sync (POST /api/cron/email-followups)
# CRON_SECRET=replace-with-a-long-random-secret

# Phase 8 — Lead Capture + HubSpot CRM
# Demo HubSpot when true or when client credentials are missing
HUBSPOT_DEMO=true
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/integrations/hubspot/callback
# Optional HMAC secret for POST /api/webhooks/leads (X-LeadPilot-Signature)
# LEAD_WEBHOOK_SECRET=replace-with-a-long-random-secret
# CORS origin for public capture / embed (default *)
# LEAD_CAPTURE_CORS_ORIGIN=*

# Optional OpenAI — only when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Experiential Labs — only when AI_PROVIDER=experiential-labs
EXPLABS_API_KEY=xpl_your_real_key
EXPLABS_BASE_URL=https://api.experientiallabs.ai
EXPLABS_MODEL=qwen3.8-27b
